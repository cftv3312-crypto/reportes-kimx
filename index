<script>
  // Detail panel logic
  const detailIds = ['L1','L2','L3','L4','L5','L6','L7','L8','L9','L10','L11','L12','L13','L14','L15','L16','L17','L18','L19'];
  let activeCard = null;

  function showDetail(id) {
    // Hide all
    document.getElementById('detail-empty').style.display = 'none';
    detailIds.forEach(did => {
      const el = document.getElementById('detail-' + did);
      if (el) el.classList.remove('active');
      const card = document.getElementById('card-' + did);
      if (card) card.classList.remove('selected');
    });
    // Show selected
    const detail = document.getElementById('detail-' + id);
    if (detail) detail.classList.add('active');
    const card = document.getElementById('card-' + id);
    if (card) card.classList.add('selected');
    activeCard = id;
  }

  // Animate progress bar on load
  window.addEventListener('load', () => {
    setTimeout(() => {
      const bar = document.getElementById('main-progress-bar');
      if (bar) bar.style.width = '63.6%';
      const pct = document.getElementById('pct-display');
      if (pct) pct.textContent = '63.6% baseline identificado';
    }, 300);
  });

  // Keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (!activeCard) return;
    const idx = detailIds.indexOf(activeCard);
    if (e.key === 'ArrowDown' && idx < detailIds.length - 1) showDetail(detailIds[idx + 1]);
    if (e.key === 'ArrowUp' && idx > 0) showDetail(detailIds[idx - 1]);
  });
</script>

